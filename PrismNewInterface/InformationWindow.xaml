<Window x:Class="PrismNewInterface.InformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Information"
        Width="700"
        Height="750"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        Icon="New Logo.ico">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#2563EB" />

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#1D4ED8" />

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#D7DEE8" />

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B" />

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#FFFFFF" />

        <!-- CLOSE BUTTON -->

        <Style x:Key="CloseButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="34" />

            <Setter Property="MinWidth"
                    Value="90" />

            <Setter Property="Padding"
                    Value="16,5" />

            <Setter Property="Foreground"
                    Value="#334155" />

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F8FAFC" />

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#CBD5E1" />

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F1F5F9" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- INFORMATION EXPANDER -->

        <Style x:Key="InformationExpanderStyle"
               TargetType="Expander">

            <Setter Property="Margin"
                    Value="0,0,0,10" />

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Expander">

                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>


                                <!-- HEADER -->

                                <ToggleButton x:Name="HeaderButton"
                                              Grid.Row="0"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              HorizontalContentAlignment="Stretch"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">

                                    <Grid Margin="14,10">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>

                                        <ContentPresenter Grid.Column="0"
                                                          ContentSource="Header"
                                                          VerticalAlignment="Center" />

                                        <Border Grid.Column="1"
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Background="#EFF6FF"
                                                BorderBrush="#BFDBFE"
                                                BorderThickness="1"
                                                CornerRadius="10">

                                            <TextBlock x:Name="Chevron"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       Text="+" />

                                        </Border>

                                    </Grid>

                                </ToggleButton>


                                <!-- EXPANDED CONTENT -->

                                <Border x:Name="ContentBorder"
                                        Grid.Row="1"
                                        Visibility="Collapsed"
                                        Padding="16,14"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="0,1,0,0"
                                        Opacity="0">

                                    <Border.RenderTransform>

                                        <TranslateTransform x:Name="ContentTransform"
                                                            Y="-6" />

                                    </Border.RenderTransform>

                                    <ContentPresenter />

                                </Border>

                            </Grid>

                        </Border>


                        <ControlTemplate.Triggers>

                            <!-- EXPANDED -->

                            <Trigger Property="IsExpanded"
                                     Value="True">

                                <Setter TargetName="ContentBorder"
                                        Property="Visibility"
                                        Value="Visible" />

                                <Setter TargetName="Chevron"
                                        Property="Text"
                                        Value="−" />

                                <Setter TargetName="OuterBorder"
                                        Property="BorderBrush"
                                        Value="#93C5FD" />

                                <Setter TargetName="OuterBorder"
                                        Property="Background"
                                        Value="#FFFFFF" />

                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="ContentBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.18">

                                                <DoubleAnimation.EasingFunction>

                                                    <CubicEase EasingMode="EaseOut" />

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="ContentTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             From="-6"
                                                             To="0"
                                                             Duration="0:0:0.18">

                                                <DoubleAnimation.EasingFunction>

                                                    <CubicEase EasingMode="EaseOut" />

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>

                            </Trigger>


                            <!-- HOVER -->

                            <Trigger SourceName="HeaderButton"
                                     Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="OuterBorder"
                                        Property="Background"
                                        Value="#FAFCFF" />

                                <Setter TargetName="OuterBorder"
                                        Property="BorderBrush"
                                        Value="#BFDBFE" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="30"
                        Height="30"
                        VerticalAlignment="Center"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="15">

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Text="i" />

                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="InformationTitleTextBlock"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               Text="Information" />

                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Prism check details and requirements" />

                </StackPanel>

            </Grid>

        </Border>


        <!-- MAIN CONTENT -->

        <Grid Grid.Row="1"
              Margin="24,20">

            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20">

                    <StackPanel>


                        <!-- INTRODUCTION -->

                        <Border Padding="14"
                                Margin="0,0,0,18"
                                Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="6">

                            <TextBlock x:Name="InformationTextBlock"
                                       FontSize="13"
                                       Foreground="#334155"
                                       LineHeight="21"
                                       TextWrapping="Wrap"
                                       Text="Example information will be displayed here." />

                        </Border>


                        <!-- INFORMATION SECTIONS -->

                        <ItemsControl x:Name="InformationSectionsItemsControl">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Expander Style="{StaticResource InformationExpanderStyle}">

                                        <Expander.Header>

                                            <StackPanel>

                                                <TextBlock FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#172033"
                                                           Text="{Binding Title}" />

                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Summary}" />

                                            </StackPanel>

                                        </Expander.Header>

                                        <TextBlock FontSize="12"
                                                   Foreground="#334155"
                                                   LineHeight="19"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Details}" />

                                    </Expander>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>


        <!-- FOOTER -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <Grid Margin="24,0">

                <TextBlock VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Expand a section to view the detailed rules." />

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource CloseButtonStyle}"
                        Content="Close"
                        Click="CloseButton_Click" />

            </Grid>

        </Border>

    </Grid>

</Window>