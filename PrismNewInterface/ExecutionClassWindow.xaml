<Window x:Class="PrismNewInterface.ExecutionClassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Execution Class"
        Width="460"
        Height="400"
        MinWidth="430"
        MinHeight="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        Icon="New Logo.ico">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D7DEE8" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="95" />
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E40AF" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="95" />
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F8FAFC" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F1F5F9" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExecutionComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="30"
                        Height="30"
                        VerticalAlignment="Center"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="15">

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Text="EX" />

                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               Text="Select Execution Class" />

                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Choose the class to apply to the parts identified by Prism." />

                </StackPanel>

            </Grid>

        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1"
              Margin="24,20">

            <Border Padding="20"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Text="Execution class" />

                    <ComboBox x:Name="ExecutionClassComboBox"
                              Grid.Row="2"
                              Style="{StaticResource ExecutionComboBoxStyle}"
                              SelectedIndex="2">

                        <ComboBoxItem Content="EXC1" />
                        <ComboBoxItem Content="EXC2" />
                        <ComboBoxItem Content="EXC3" />
                        <ComboBoxItem Content="EXC4" />

                    </ComboBox>

                    <Border Grid.Row="4"
                            Padding="12"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="6">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="18"
                                    Height="18"
                                    VerticalAlignment="Top"
                                    Background="White"
                                    BorderBrush="#93C5FD"
                                    BorderThickness="1"
                                    CornerRadius="9">

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="i" />

                            </Border>

                            <TextBlock Grid.Column="1"
                                       Margin="4,0,0,0"
                                       FontSize="11"
                                       Foreground="#1D4ED8"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       Text="This value will be applied only to the parts currently identified as missing an execution class." />

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <Grid Margin="24,0">

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Content="Cancel"
                            IsCancel="True" />

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="Apply"
                            IsDefault="True"
                            Click="ApplyButton_Click" />

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>